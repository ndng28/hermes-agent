# Hermes Agent Environment Configuration
# Copy this file to .env and fill in your API keys
# Full documentation: https://hermes-agent.nousresearch.com/docs
#
# Configure defaults in ~/.hermes/config.yaml (use 'hermes setup' or 'hermes config set').
# Model selection, terminal backend, compression, TTS, STT, and display are all config.yaml settings.
# Only API keys and platform tokens belong here.

# ── LLM Provider Keys ──────────────────────────────────────────────────────────
# OpenRouter (multi-model proxy)     → https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# NovitaAI (90+ models, pay-per-use) → https://novita.ai/settings/key-management
# NOVITA_API_KEY=
# Google AI Studio / Gemini          → https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=
# Ollama Cloud (hosted open models)  → https://ollama.com/settings
# OLLAMA_API_KEY=
# z.ai / GLM models                  → https://z.ai or https://open.bigmodel.cn
# GLM_API_KEY=
# Kimi Code / Moonshot               → https://platform.kimi.ai
# KIMI_API_KEY=
# Arcee AI (Trinity models)          → https://chat.arcee.ai
# ARCEEAI_API_KEY=
# MiniMax                            → https://www.minimax.io
# MINIMAX_API_KEY=
# OpenCode Zen (curated models)      → https://opencode.ai/auth
# OPENCODE_ZEN_API_KEY=
# OpenCode Go ($10/mo open models)   → https://opencode.ai/auth
# OPENCODE_GO_API_KEY=
# HuggingFace Inference Providers    → https://huggingface.co/settings/tokens
# HF_TOKEN=
# Xiaomi MiMo                        → https://platform.xiaomimimo.com
# XIAOMI_API_KEY=

# Qwen OAuth: no key needed — run `qwen auth qwen-oauth` for local credentials.

# ── Tool API Keys ──────────────────────────────────────────────────────────────
# EXA_API_KEY=           # https://exa.ai
# PARALLEL_API_KEY=      # https://parallel.ai
# FIRECRAWL_API_KEY=     # https://firecrawl.dev
# FAL_KEY=               # https://fal.ai (image generation)
# HONCHO_API_KEY=        # https://app.honcho.dev (cross-session user modeling)
# GROQ_API_KEY=          # https://console.groq.com (free-tier Whisper STT)
# VOICE_TOOLS_OPENAI_KEY=# https://platform.openai.com (Whisper + OpenAI TTS)
# GITHUB_TOKEN=          # https://github.com/settings/tokens (skills hub rate limits)

# ── Browser Tool ───────────────────────────────────────────────────────────────
# BROWSERBASE_API_KEY=          # https://browserbase.com
# BROWSERBASE_PROJECT_ID=       # From Browserbase dashboard
BROWSERBASE_PROXIES=true
BROWSERBASE_ADVANCED_STEALTH=false
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120
# CAMOFOX_URL=http://localhost:9377   # Local Camofox anti-detection browser

# ── Terminal Tool ──────────────────────────────────────────────────────────────
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300
# HERMES_DOCKER_BINARY=/usr/local/bin/podman  # Use Podman instead of Docker

# ── Messaging Platforms ────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=xoxb-...     SLACK_APP_TOKEN=xapp-...
# TEAMS_CLIENT_ID=             TEAMS_CLIENT_SECRET=       TEAMS_TENANT_ID=
# EMAIL_ADDRESS=               EMAIL_PASSWORD=            (see docs for IMAP/SMTP)
# GOOGLE_CHAT_PROJECT_ID=      GOOGLE_CHAT_SUBSCRIPTION_NAME=
#                                GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=

# ── Debug ──────────────────────────────────────────────────────────────────────
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false
